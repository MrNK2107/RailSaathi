# Rendered by the nginx image's envsubst step. Only ${PORT}, ${BACKEND_URL} and ${NGINX_RESOLVER}
# are substituted; nginx's own $variables are left alone because they are not environment variables.
# NGINX_RESOLVER is exported by nginx/15-resolver.envsh from the container's /etc/resolv.conf, so the
# same image works on Cloud Run (public backend hostname) and in Docker Compose (service names).

resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
resolver_timeout 5s;

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# The real client IP is the LAST X-Forwarded-For entry: the one Google Front End appended. Everything to its
# left is client-supplied and spoofable. Falls back to the socket peer (Docker Compose, direct access).
map $http_x_forwarded_for $real_client_ip {
    default                         $remote_addr;
    "~(?<last>[^,\s]+)\s*$"         $last;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;

    gzip on;
    # Level 6 is what the bundle budgets in scripts/check-budget.mjs measure (nginx's default is 1).
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript application/manifest+json image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The backend API. There are no non-/api alias routes.
    location ~ ^/api(/|$) {
        include /etc/nginx/snippets/security-headers.conf;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $real_client_ip;  # overwrite, never append
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
        client_max_body_size 64k;
    }

    # Hashed build assets are immutable.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The app uses hash routing, so only the shell itself needs to be served; the shell is never cached.
    location = / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # The service worker script and the manifest are always revalidated, so a deploy replaces them at once (the browser
    # would otherwise cache them by heuristics). Served from 'self', which worker-src and default-src allow.
    location = /sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        default_type application/manifest+json;
        try_files $uri =404;
    }

    # Everything else (favicon, manifest, future public files) must exist on disk.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }
}
