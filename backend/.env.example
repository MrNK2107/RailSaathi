# RailSaathi AI — Smart Passenger Planner backend configuration
# Copy to backend/.env and edit. NEVER commit .env or real credentials.

APP_ENV=development
TIMEZONE=Asia/Kolkata
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Planning policy
MAX_PASSENGERS=6
MAX_PLANNING_DAYS=120
MIN_TRANSFER_MINUTES=30
SESSION_TTL_MINUTES=120
RECOMMENDATION_TTL_MINUTES=30

# Request hardening
MAX_BODY_BYTES=16384
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Optional LLM: LLM_PROVIDER = gemini | bedrock | none
# ---------------------------------------------------------------------------
# gemini (production default): Gemini on Vertex AI for planner intent extraction AND the
# ticketing agent. Uses Application Default Credentials (Cloud Run service account, or
# `gcloud auth application-default login` locally); no API key in production.
#   GOOGLE_CLOUD_PROJECT=your-project-id
#   GOOGLE_CLOUD_LOCATION=us-central1
#   GEMINI_MODEL=gemini-2.0-flash
#   GEMINI_TIMEOUT_SECONDS=10        # per call; clipped to LLM_OVERALL_DEADLINE_SECONDS
#   GEMINI_MAX_RETRIES=2             # retries on 429 / 5xx only
# LLM_OVERALL_DEADLINE_SECONDS (default 20) bounds a whole planner/agent turn across every
# LLM call and retry; SESSION_LOCK_TTL_MS must be at least that plus 10 s.
#
# ollama (development only, ignored when APP_ENV=production): a local model for the ticketing agent.
# LLM_FALLBACK=ollama keeps Gemini as the provider and falls back to the local model when a Gemini call fails.
#   LLM_PROVIDER=ollama              # or LLM_FALLBACK=ollama with LLM_PROVIDER=gemini
#   OLLAMA_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=gemma4:latest
#   OLLAMA_NUM_CTX=8192              # 1024-32768
#   OLLAMA_KEEP_ALIVE=10m
#   OLLAMA_TIMEOUT_SECONDS=18        # per call; clipped to LLM_OVERALL_DEADLINE_SECONDS
#   LLM_FALLBACK=none                # none | ollama
#
# bedrock: Claude on AWS Bedrock for intent extraction only (see below).
# Leave LLM_PROVIDER=none to use only the deterministic rule-based extractor.
# The app ALWAYS starts and works without AWS; on any Bedrock problem it falls
# back to the rule-based extractor automatically.
#
# To enable later:
#   1. Configure AWS credentials with the standard AWS credential chain, e.g.
#        aws configure            (access keys)    or
#        aws configure sso        (IAM Identity Center / SSO)
#      and grant bedrock:InvokeModel (Converse) on the chosen model/profile.
#   2. Find the exact model ID or inference profile available to your account:
#        aws bedrock list-inference-profiles --region <region>
#        aws bedrock list-foundation-models --region <region> --by-provider anthropic
#   3. Fill in the values below (do not guess them), then run:
#        uv run python scripts/check_bedrock.py
LLM_PROVIDER=none
AWS_REGION=
BEDROCK_MODEL_ID=
# Optional named profile from ~/.aws/config (leave empty to use the default chain)
AWS_PROFILE=
BEDROCK_TIMEOUT_SECONDS=15
BEDROCK_MAX_RETRIES=2

# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file if you can
# avoid it — prefer `aws configure` / SSO profiles. If you must, set them as
# real environment variables in your shell, never in a committed file.

# ---------------------------------------------------------------------------
# Railway data source
# ---------------------------------------------------------------------------
# ntes      = live NTES data through the UNOFFICIAL ntes-client package (no key; what
#             `python run.py` uses when RAILWAY_DATA_MODE is not set). Not an authorised
#             integration: it can break or be blocked, and NTES's terms of use apply.
#             Labelled "NTES (unofficial client)" everywhere. See docs/DATA_PROVIDERS.md.
# demo      = bundled simulated trains (the backend's own default, used by tests and e2e)
# railradar = live third-party data from https://railradar.in (needs an API key)
# If RAILWAY_DATA_MODE=railradar but the key is empty, the app does NOT fall back to
# demo trains: searches report "live data not configured" and /api/health shows
# reason "railradar_api_key_missing". (DATA_PROVIDER is accepted as an alias.)
RAILWAY_DATA_MODE=ntes
# NTES politeness budget (RailSaathi's own limit; NTES publishes none), timeouts and cache.
NTES_REQUESTS_PER_MINUTE=20
NTES_TIMEOUT_SECONDS=10
NTES_CALL_BUDGET_SECONDS=15
NTES_CACHE_SECONDS=300
NTES_STALE_SECONDS=21600
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in
RAILRADAR_TIMEOUT_SECONDS=10
RAILRADAR_CACHE_SECONDS=300
RAILRADAR_MAX_CONCURRENCY=4
# Observed limit for the current key: 10 requests/minute (HTTP 429 beyond that).
RAILRADAR_REQUESTS_PER_MINUTE=10

# Shared state / session security (Phase 2a)
REDIS_URL=
SESSION_SIGNING_KEY=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LLM_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Indoor station navigation (read-only at runtime)
# ---------------------------------------------------------------------------
# Station data root: a local directory (default: data/stations) or gs://bucket/prefix
# holding catalogue.json and one folder per published station version. Stations are
# validated and published with `uv run python scripts/stations.py` (see its --help).
# STATIONS_URI=gs://your-bucket/stations
# Lets anyone add what-if closures to one route request (nothing is stored).
# Always off when APP_ENV=production, whatever this says.
PUBLIC_DISRUPTION_SIMULATION=true
# AR guidance (POST /api/navigation/localize, Gemini vision; needs LLM_PROVIDER=gemini). Comma-separated station
# ids or "*"; unset = "*" outside production and off in production until the localisation evaluation passes.
# AR_GUIDANCE_ENABLED=chennai_central
# LOCALIZE_CONFIDENCE_THRESHOLD=0.6   # below it the answer is candidates, not a fix
# LOCALIZE_MAX_IMAGE_BYTES=1500000    # JPEG/WebP frame; LOCALIZE_RATE_LIMIT=20 per session per 600 s
# Public, referrer-restricted Maps JavaScript key for the virtual tour (Secret Manager in production).
# GOOGLE_MAPS_BROWSER_KEY=
# Default lifetime of a disruption written via POST /internal/stations/{id}/disruptions
# (Cloud Run OIDC, same INTERNAL_OIDC_AUDIENCE / INTERNAL_OIDC_SERVICE_ACCOUNT as /internal/collect).
DISRUPTION_TTL_SECONDS=21600
